extends layout

block content
  header.header-text-2
    .container
      .row
        .col.text-center.text-light
          h1= title

  .container.vn-blog.vn-blog--article
    .vn-blog__article-inner

      span.vn-blog__article-label Crezcamos Juntos

      h1.vn-blog__article-title= blog.title

      if blog.subtitle
        p.vn-blog__article-subtitle= blog.subtitle

      .vn-blog__article-meta
        span= blog.author
        span= blog.date

      if blog.imageUrl
        img.vn-blog__article-cover(src=blog.imageUrl alt=blog.title)

      hr.vn-blog__article-divider

      .blog-content!= content

      hr.vn-blog__article-divider

      a.vn-blog__back(href='/blog') ← Regresar al Blog
