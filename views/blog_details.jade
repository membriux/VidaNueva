extends layout

block content
  header.header-text-2
    .container
      .row
        .col.text-center.text-light
          h1= title

  .container.mt-4.mb-5
    .row.justify-content-center
      .col-lg-8
        if blog.imageUrl
          img.img-fluid.rounded.mb-4(src=blog.imageUrl alt=blog.title)
        p.text-muted.blog-meta
          | Por #{blog.author} &nbsp;·&nbsp; #{blog.date}
        hr
        .blog-content!= content
        hr
        a.btn.btn-secondary(href='/blog') ← Regresar al Blog
